# Copy this file to ".env" and adjust as needed:  cp .env.example .env

# JWT signing key used by the backend to sign access tokens.
# Use a long, random secret (>= 32 chars) for anything beyond local testing.
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Internal URL the Next.js *server* uses to reach the backend.
# In Docker Compose this is the backend service name — leave as is.
# (The browser never calls the backend directly; all data fetching is server-side.)
API_BASE_URL_INTERNAL=http://backend:5160
